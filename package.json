{
  "name": "userscripts",
  "version": "1.0.0",
  "description": "Collection of userscripts for various websites",
  "type": "module",
  "author": "jaredcat",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint && tsc --noEmit",
    "lint:fix": "eslint --fix && tsc --noEmit",
    "dev:script": "vite --mode",
    "build": "tsc && node scripts/build-all.cjs",
    "build:script": "vite build --mode",
    "build:all": "vite build --config vite.config.ts"
  },
  "dependencies": {
    "@violentmonkey/dom": "^2.2.1",
    "@violentmonkey/ui": "^0.7.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.2.0",
    "@violentmonkey/types": "^0.3.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-monkey": "^8.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.21.0"
}
