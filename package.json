{
  "name": "userscripts",
  "version": "1.0.0",
  "description": "Collection of userscripts for various websites",
  "type": "module",
  "author": "jaredcat",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint && tsc --noEmit",
    "lint:fix": "eslint --fix && tsc --noEmit",
    "dev:script": "vite --mode",
    "build": "tsc && node scripts/build-all.cjs",
    "build:script": "vite build --mode",
    "build:all": "vite build --config vite.config.ts"
  },
  "dependencies": {
    "@violentmonkey/dom": "^2.2.1",
    "@violentmonkey/ui": "^0.7.9"
  },
  "devDependencies": {
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.6.6",
    "@violentmonkey/types": "^0.3.5",
    "eslint": "^10.15.0",
    "eslint-config-narwhal": "^2.1.16",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-monkey": "^8.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.21.0"
}
